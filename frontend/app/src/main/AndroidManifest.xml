<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso de internet para conectarse al backend -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AplicacionDestionDeCombustibles"
        android:usesCleartextTraffic="true">
        <service
            android:name=".UI.distribuidor.FuelRegistrationService"
            android:exported="false"></service>
        <!-- AUTH (compartido) -->
        <activity
            android:name=".UI.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".UI.auth.RegisterActivity"
            android:exported="false" /> <!-- USUARIO -->
        <activity
            android:name=".UI.usuario.UsuarioDashboardActivity"
            android:exported="false" /> <!-- ESTACIÓN DE SERVICIO -->
        <activity
            android:name=".UI.estacion.EstacionDashboardActivity"
            android:exported="false" /> <!-- ENTIDAD REGULADORA -->
        <activity
            android:name=".UI.regulador.ReguladorDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".UI.usuario.RegistrarVehiculoActivity"
            android:exported="false" />
        <activity
            android:name=".UI.estacion.ConsultarPrecioActivity"
            android:exported="false" />
        <activity
            android:name=".UI.distribuidor.DistribuidorDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".UI.distribuidor.RegistrarEntregaActivity"
            android:exported="false" />
        <activity
            android:name=".UI.estacion.InventarioActivity"
            android:exported="false" />
        <activity
            android:name=".UI.estacion.RegistrarVentaActivity"
            android:exported="false" />
        <activity
            android:name=".UI.regulador.ActualizarPrecioActivity"
            android:exported="false" />
        <activity
            android:name=".UI.administrador.GestionUsuariosActivity"
            android:exported="false" />
        <activity
            android:name=".UI.usuario.EditarPerfilActivity"
            android:label="Editar Perfil"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />
        <activity
            android:name=".UI.administrador.AdministradorDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".UI.usuario.RecompensasActivity"
            android:exported="false" />
        <activity
            android:name=".UI.usuario.EstacionesCercanasActivity"
            android:exported="false" />
        <service
            android:name=".UI.distribuidor.FuelRegistrationService"
            android:exported="false" />
        <service
            android:name=".UI.usuario.OdometerService"
            android:exported="false" />

    </application>

</manifest>
