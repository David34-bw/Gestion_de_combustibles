<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_estacion"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fuel_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FuelControl"
                android:textColor="@color/fuel_orange"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_logout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Salir"
                android:textSize="12sp"
                android:backgroundTint="@color/fuel_dark_card"
                android:textColor="@color/fuel_white"/>
        </LinearLayout>

        <!-- Bienvenida -->
        <TextView
            android:id="@+id/tv_welcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenido, Estación"
            android:textColor="@color/fuel_white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp"/>

        <!-- Módulos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tab_precios"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Precios"
                        android:textSize="12sp"
                        android:backgroundTint="@color/fuel_dark_card"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tab_inventario"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Inventario"
                        android:textSize="12sp"
                        android:backgroundTint="@color/fuel_dark_card"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tab_registrar"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Registrar"
                        android:textSize="12sp"
                        android:backgroundTint="@color/fuel_dark_card"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tab_historial"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Historial"
                        android:textSize="12sp"
                        android:backgroundTint="@color/fuel_dark_card"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tv_acciones_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acciones principales"
                android:textColor="@color/fuel_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <!-- Botón consultar precios -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_precios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fuel_dark_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Precios por Zona"
                        android:textColor="@color/fuel_orange"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consulta precios vigentes según zona, tipo de combustible y vehículo."
                        android:textColor="@color/fuel_gray"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_consultar_precios"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Consultar Precios"
                        android:textSize="14sp"
                        app:backgroundTint="@color/fuel_orange"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_inventario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fuel_dark_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Inventario"
                        android:textColor="@color/fuel_orange"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carga y consulta el inventario de combustible disponible."
                        android:textColor="@color/fuel_gray"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_inventario"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Ver Inventario"
                        android:textSize="14sp"
                        app:backgroundTint="@color/fuel_orange"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_historial_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Historial"
                android:textColor="@color/fuel_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_registrar_venta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fuel_dark_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💳 Registrar Venta"
                        android:textColor="@color/fuel_orange"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registra ventas de combustible y monitorea el stock."
                        android:textColor="@color/fuel_gray"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_registrar_venta"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Nueva Venta"
                        android:textSize="14sp"
                        app:backgroundTint="@color/fuel_orange"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_historial_ventas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fuel_dark_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧾 Historial de Ventas"
                        android:textColor="@color/fuel_orange"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tv_sin_ventas_estacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No hay ventas registradas aún."
                        android:textColor="@color/fuel_gray"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:visibility="visible"/>

                    <LinearLayout
                        android:id="@+id/ll_ventas_estacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
