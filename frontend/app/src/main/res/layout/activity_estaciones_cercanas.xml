<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fuel_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estaciones cercanas"
            android:textColor="@color/fuel_white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona una estación para planear tu recorrido."
            android:textColor="@color/fuel_gray"
            android:textSize="13sp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubicación"
            android:textColor="@color/fuel_orange"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_ubicacion_estaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ubicación"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:textColorHint="@color/fuel_gray_light"
            app:boxStrokeColor="@color/fuel_orange"
            app:hintTextColor="@color/fuel_gray"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_direccion_estaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fuel_white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:cursorVisible="false"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_obtener_ubicacion_estaciones"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Usar mi ubicación actual"
            android:textSize="13sp"
            app:backgroundTint="@color/fuel_dark_card"
            android:textColor="@color/fuel_orange"
            app:cornerRadius="8dp"
            app:strokeColor="@color/fuel_orange"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración de seguimiento"
            android:textColor="@color/fuel_orange"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_precision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precisión (metros)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:textColorHint="@color/fuel_gray_light"
            app:boxStrokeColor="@color/fuel_orange"
            app:hintTextColor="@color/fuel_gray"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_precision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fuel_white"
                android:textSize="13sp"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_intervalo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tiempo de actualización (segundos)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:textColorHint="@color/fuel_gray_light"
            app:boxStrokeColor="@color/fuel_orange"
            app:hintTextColor="@color/fuel_gray"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_intervalo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fuel_white"
                android:textSize="13sp"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_odometro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distancia recorrida: 0 m"
            android:textColor="@color/fuel_white"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_ubicacion_actual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación actual: -"
            android:textColor="@color/fuel_gray"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_sin_estaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay estaciones disponibles cerca."
            android:textColor="@color/fuel_gray"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ll_estaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_planear_recorrido"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Planear recorrido"
            android:textSize="14sp"
            android:enabled="false"
            app:backgroundTint="@color/fuel_orange"
            android:textColor="@color/fuel_white"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>
