<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fuel_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦 Gestión de Inventario"
            android:textColor="@color/fuel_orange"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Card alerta (oculta por defecto) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_alerta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#3D1515"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/fuel_error"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Alerta de Stock Bajo"
                    android:textColor="@color/fuel_error"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_alerta_gasolina"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Stock de gasolina por debajo del 25%"
                    android:textColor="@color/fuel_white"
                    android:textSize="13sp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_alerta_diesel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Stock de diesel por debajo del 25%"
                    android:textColor="@color/fuel_white"
                    android:textSize="13sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card stock actual -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fuel_dark_card"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock Actual"
                    android:textColor="@color/fuel_orange"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- Gasolina -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⛽ Gasolina"
                        android:textColor="@color/fuel_gray_light"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tv_stock_gasolina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 gal"
                        android:textColor="@color/fuel_white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/fuel_divider"
                    android:layout_marginBottom="12dp"/>

                <!-- Diesel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🛢️ Diésel"
                        android:textColor="@color/fuel_gray_light"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tv_stock_diesel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 gal"
                        android:textColor="@color/fuel_white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card agregar stock -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fuel_dark_card"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargar Inventario"
                    android:textColor="@color/fuel_orange"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <RadioGroup
                    android:id="@+id/rg_tipo_combustible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rb_gasolina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gasolina"
                        android:textColor="@color/fuel_white"
                        android:checked="true"
                        android:buttonTint="@color/fuel_orange"
                        android:layout_marginEnd="24dp"/>

                    <RadioButton
                        android:id="@+id/rb_diesel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diésel"
                        android:textColor="@color/fuel_white"
                        android:buttonTint="@color/fuel_orange"/>
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Cantidad (galones)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/fuel_orange"
                    app:hintTextColor="@color/fuel_gray"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_cantidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fuel_white"
                        android:inputType="numberDecimal"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_agregar_stock"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Agregar al Inventario"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/fuel_orange"
                    android:textColor="@color/fuel_white"
                    app:cornerRadius="10dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>