<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#1E2333"
    app:cardCornerRadius="10dp"
    app:strokeColor="@color/fuel_divider"
    app:strokeWidth="1dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_zona_combustible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fuel_orange"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_precio_anterior"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/fuel_error"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tv_precio_nuevo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/fuel_success"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_fecha_cambio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fuel_gray"
            android:textSize="11sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>