<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_usuario"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fuel_dark">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FuelControl"
                android:textColor="@color/fuel_orange"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_ir_perfil"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/fuel_orange"
                app:cardBackgroundColor="@color/fuel_dark_card">

                <ImageView
                    android:id="@+id/iv_profile_pic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@mipmap/ic_launcher_round"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto de perfil"/>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Bienvenida -->
        <TextView
            android:id="@+id/tv_welcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenido, Usuario"
            android:textColor="@color/fuel_white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp"/>

        <TextView
            android:id="@+id/tv_puntos_resumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puntos: 0"
            android:textColor="@color/fuel_gray"
            android:textSize="13sp"
            android:paddingHorizontal="20dp"
            android:paddingBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tab_precios"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Precios"
                        android:textSize="12sp"
                        android:backgroundTint="@color/fuel_dark_card"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tab_recompensas"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Recompensas"
                        android:textSize="12sp"
                        android:backgroundTint="@color/fuel_dark_card"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tab_vehiculos"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Vehiculos"
                        android:textSize="12sp"
                        android:backgroundTint="@color/fuel_dark_card"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tab_historial"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Historial"
                        android:textSize="12sp"
                        android:backgroundTint="@color/fuel_dark_card"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tab_comprar"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="Comprar"
                        android:textSize="12sp"
                        android:backgroundTint="@color/fuel_dark_card"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tab_estaciones"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="Estaciones cercanas"
                        android:textSize="12sp"
                        android:backgroundTint="@color/fuel_dark_card"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tv_acciones_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acciones principales"
                android:textColor="@color/fuel_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <!-- Card consultar precios -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_precios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fuel_dark_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💰 Precios por Zona"
                        android:textColor="@color/fuel_orange"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consulta precios vigentes según zona y tipo de combustible."
                        android:textColor="@color/fuel_gray"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ver_precios"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Ver Precios"
                        android:textSize="14sp"
                        app:backgroundTint="@color/fuel_orange"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card puntos y recompensas -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_recompensas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fuel_dark_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Puntos y Recompensas"
                        android:textColor="@color/fuel_orange"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acumula puntos por tus compras y canjea beneficios."
                        android:textColor="@color/fuel_gray"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_recompensas"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Ver Catálogo"
                        android:textSize="14sp"
                        app:backgroundTint="@color/fuel_orange"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_vehiculos_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gestión de vehículos"
                android:textColor="@color/fuel_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"/>

            <!-- Card mis vehículos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_vehiculos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fuel_dark_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Título + botón -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🚗 Mis Vehículos"
                            android:textColor="@color/fuel_orange"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_registrar_vehiculo"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="+ Agregar"
                            android:textSize="12sp"
                            app:backgroundTint="@color/fuel_orange"
                            android:textColor="@color/fuel_white"
                            app:cornerRadius="8dp"/>
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinner_filtro"
                        style="@style/CustomSpinnerStyle"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Sin vehículos -->
                    <TextView
                        android:id="@+id/tv_sin_vehiculos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No tienes vehículos registrados aún."
                        android:textColor="@color/fuel_gray"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:visibility="visible"/>

                    <!-- Lista dinámica de vehículos -->
                    <LinearLayout
                        android:id="@+id/ll_vehiculos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_historial_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Historial"
                android:textColor="@color/fuel_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/tv_comprar_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comprar"
                android:textColor="@color/fuel_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/tv_estaciones_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estaciones cercanas"
                android:textColor="@color/fuel_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_historial_compras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fuel_dark_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧾 Historial de Compras"
                        android:textColor="@color/fuel_orange"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tv_sin_compras"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No tienes compras registradas aún."
                        android:textColor="@color/fuel_gray"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:visibility="visible"/>

                    <LinearLayout
                        android:id="@+id/ll_compras"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_comprar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fuel_dark_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⛽ Comprar combustible"
                        android:textColor="@color/fuel_orange"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecciona la estación, tu vehículo y registra la compra."
                        android:textColor="@color/fuel_gray"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_comprar_combustible"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Comprar ahora"
                        android:textSize="14sp"
                        app:backgroundTint="@color/fuel_orange"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_estaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/fuel_dark_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⛽ Estaciones cercanas"
                        android:textColor="@color/fuel_orange"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consulta estaciones cerca de ti y planifica un recorrido."
                        android:textColor="@color/fuel_gray"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ver_estaciones_cercanas"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Ver estaciones"
                        android:textSize="14sp"
                        app:backgroundTint="@color/fuel_orange"
                        android:textColor="@color/fuel_white"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btn_logout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/fuel_dark_card"
                android:text="Salir"
                android:textColor="@color/fuel_white"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
