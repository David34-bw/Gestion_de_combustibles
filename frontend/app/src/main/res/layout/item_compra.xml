<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#1E2333"
    app:cardCornerRadius="10dp"
    app:strokeColor="@color/fuel_divider"
    app:strokeWidth="1dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🧾"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_estacion_compra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fuel_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_tipo_compra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fuel_orange"
                android:textSize="12sp"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tv_placa_compra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fuel_gray_light"
                android:textSize="12sp"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tv_fecha_compra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fuel_gray"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_cantidad_compra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fuel_white"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>