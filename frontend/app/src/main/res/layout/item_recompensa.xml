<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/fuel_dark_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_recompensa_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fuel_orange"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tv_recompensa_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fuel_gray"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_recompensa_costo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fuel_white"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tv_recompensa_beneficio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fuel_white"
                android:textSize="13sp"
                android:layout_marginStart="12dp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_canjear"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Canjear"
                android:textSize="12sp"
                app:backgroundTint="@color/fuel_orange"
                android:textColor="@color/fuel_white"
                app:cornerRadius="8dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
